{
    "name": "dagasmart/gateway",
    "alias": "网关服务",
    "description": "实现短信、邮件发送/验证、nanoMQ/MQTT/IOT边缘网关服务等",
    "type": "library",
    "version": "1.0.0",
    "keywords": ["bizadmin", "extension"],
    "homepage": "https://github.com/dagasmart/gateway",
    "license": "MIT",
    "authors": [
        {
            "name": "Administrator",
            "email": "dagasmart@163.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "dagasmart/bizadmin": "*"
    },
    "autoload": {
        "psr-4": {
            "DagaSmart\\Gateway\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "bizadmin": "DagaSmart\\Gateway\\GatewayServiceProvider",
        "laravel": {
            "providers": [
                "DagaSmart\\Gateway\\GatewayServiceProvider"
            ]
        }
    }
}
